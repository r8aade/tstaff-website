generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum TimeEntryStatus {
  OPEN // clocked in, still working
  SUBMITTED // clocked out, waiting for admin review
  APPROVED // posted to the client's hours
  REJECTED
}

enum TimeOffType {
  VACATION
  SICK
  PERSONAL
  OTHER
}

enum TimeOffStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

enum PaymentType {
  ONE_TIME
  SUBSCRIPTION
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  name             String
  companyName      String?
  role             Role     @default(CLIENT)
  hourlyRateCents  Int      @default(1200)
  stripeCustomerId String?  @unique
  // IANA timezone this user sees times in (clients: their own; admins: company time)
  timezone         String   @default("America/Chicago")
  // true only for the built-in "Talnt Staffing (Overhead)" client: internal work, never billed, can't log in
  isInternal       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  hoursEntries HoursEntry[]
  payments     Payment[]

  // Set when role = EMPLOYEE
  employee            Employee?
  // Set when role = CLIENT: employees assigned to this client
  clientAssignments   Assignment[]       @relation("ClientAssignments")
  reviewedTimeOff     TimeOffRequest[]   @relation("TimeOffReviewer")
  reviewedTimeEntries TimeEntry[]        @relation("TimeEntryReviewer")
  completedOnboarding OnboardingItem[]   @relation("OnboardingCompleter")
  uploadedDocuments   EmployeeDocument[] @relation("DocumentUploader")
  reviewedAdjustments TimeAdjustment[]   @relation("AdjustmentReviewer")
}

model Employee {
  id             String         @id @default(cuid())
  userId         String         @unique
  title          String? // e.g. "Customer Service Representative"
  country        String         @default("PH")
  timezone       String         @default("Asia/Manila")
  phone          String?
  payRateCents   Int            @default(0) // what Talnt pays them per hour (record only)
  status         EmployeeStatus @default(ACTIVE)
  startDate      DateTime? // calendar date (UTC midnight); vacation unlocks 6 months after this
  // Time off balances copied from Gusto (Gusto does the accrual). Null = not entered yet.
  vacationHours  Float?
  sickHours      Float?
  balancesAsOf   DateTime?
  // Roll-off: set together when someone leaves. archivedAt moves them to the Archived tab.
  endDate        DateTime?
  rollOffReason  String?
  rollOffNote    String?
  rehireEligible Boolean?
  archivedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments Assignment[]
  timeEntries TimeEntry[]
  timeOff     TimeOffRequest[]
  adjustments TimeAdjustment[]
  onboarding  OnboardingItem[]
  documents   EmployeeDocument[]
  signatures  Signature[]
}

// Which employee works for which client, and what the client is billed per hour.
model Assignment {
  id            String    @id @default(cuid())
  employeeId    String
  clientId      String
  billRateCents Int
  active        Boolean   @default(true)
  startDate     DateTime  @default(now())
  endDate       DateTime?
  // Work schedule in the client's time. schedDays = weekday digits, Sunday 0 ("12345" = Mon–Fri).
  schedDays     String?
  schedStart    String? // "08:00"
  schedEnd      String? // "17:00" (earlier than start = ends next day)
  createdAt     DateTime  @default(now())

  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  client      User             @relation("ClientAssignments", fields: [clientId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]
  adjustments TimeAdjustment[]

  @@index([employeeId])
  @@index([clientId])
}

// One clock-in to clock-out session. All times stored in UTC.
model TimeEntry {
  id               String          @id @default(cuid())
  employeeId       String
  assignmentId     String
  clockIn          DateTime
  clockOut         DateTime?
  breakMinutes     Int             @default(0)
  breakStartedAt   DateTime?
  notes            String?
  // Where the phone was at clock in / clock out. Null if the employee did not share it,
  // with the reason in *GeoIssue ("denied", "unavailable", "timeout", "unsupported").
  clockInLat       Float?
  clockInLng       Float?
  clockInAccuracy  Int? // metres
  clockInGeoIssue  String?
  clockOutLat      Float?
  clockOutLng      Float?
  clockOutAccuracy Int?
  clockOutGeoIssue String?
  status           TimeEntryStatus @default(OPEN)
  adminNote        String?
  reviewedById     String?
  reviewedAt       DateTime?
  hoursEntryId     String?         @unique // the client billing line created on approval
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignment  Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  reviewedBy  User?            @relation("TimeEntryReviewer", fields: [reviewedById], references: [id])
  hoursEntry  HoursEntry?      @relation(fields: [hoursEntryId], references: [id])
  adjustments TimeAdjustment[]

  @@index([employeeId, clockIn])
  @@index([status])
}

enum AdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// An employee asking to fix a shift's times, or to add a shift they forgot to clock.
// timeEntryId null = missed shift. Times are UTC; orig* is what the shift said when they asked.
model TimeAdjustment {
  id               String           @id @default(cuid())
  employeeId       String
  assignmentId     String
  timeEntryId      String?
  clockIn          DateTime
  clockOut         DateTime
  breakMinutes     Int              @default(0)
  origClockIn      DateTime?
  origClockOut     DateTime?
  origBreakMinutes Int?
  reason           String
  status           AdjustmentStatus @default(PENDING)
  adminNote        String?
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime         @default(now())

  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  timeEntry  TimeEntry? @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  reviewedBy User?      @relation("AdjustmentReviewer", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
  @@index([employeeId])
  @@index([timeEntryId])
}

model TimeOffRequest {
  id           String        @id @default(cuid())
  employeeId   String
  startDate    DateTime // stored as a calendar date (UTC midnight)
  endDate      DateTime
  type         TimeOffType   @default(VACATION)
  reason       String?
  status       TimeOffStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime      @default(now())

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewedBy User?    @relation("TimeOffReviewer", fields: [reviewedById], references: [id])

  @@index([employeeId])
  @@index([status])
}

model HoursEntry {
  id             String   @id @default(cuid())
  userId         String
  date           DateTime
  hours          Float
  description    String?
  rateCentsAtLog Int
  createdAt      DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeEntry TimeEntry?

  @@index([userId])
}

model Lead {
  id              String   @id @default(cuid())
  name            String?
  phone           String?
  businessType    String
  hoursPerWeek    String
  timezone        String
  email           String
  resourcesNeeded String?
  requirements    String?
  createdAt       DateTime @default(now())
}

model Payment {
  id                      String        @id @default(cuid())
  userId                  String
  amountCents             Int
  type                    PaymentType
  status                  PaymentStatus @default(PENDING)
  stripeCheckoutSessionId String?       @unique
  stripePaymentIntentId   String?
  stripeSubscriptionId    String?
  createdAt               DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Onboarding checklist, one row per step per employee. Created from a default list.
model OnboardingItem {
  id            String    @id @default(cuid())
  employeeId    String
  label         String
  sortOrder     Int       @default(0)
  needsDocument Boolean   @default(false)
  completedAt   DateTime?
  completedById String?
  createdAt     DateTime  @default(now())

  employee    Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  completedBy User?              @relation("OnboardingCompleter", fields: [completedById], references: [id])
  documents   EmployeeDocument[]

  @@index([employeeId])
}

// Files on an employee's profile (contract, NDA, ID). Stored in the database; only
// admins and the employee can download them, through /api/documents/[id].
model EmployeeDocument {
  id               String   @id @default(cuid())
  employeeId       String
  onboardingItemId String?
  fileName         String
  mimeType         String
  size             Int
  data             Bytes
  uploadedById     String
  createdAt        DateTime @default(now())

  employee       Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  onboardingItem OnboardingItem? @relation(fields: [onboardingItemId], references: [id], onDelete: SetNull)
  uploadedBy     User            @relation("DocumentUploader", fields: [uploadedById], references: [id])

  @@index([employeeId])
}

enum IntakeStatus {
  NEW
  REVIEWED
  CONVERTED
  CLOSED
}

/// Detailed client onboarding form: which roles they need and which skills each role must have.
model ClientIntake {
  id          String       @id @default(cuid())
  companyName String
  contactName String
  email       String
  phone       String
  website     String?
  industry    String
  timezone    String
  startDate   String? // "ASAP", "Within 2 weeks", etc.
  roles       Json // [{ roleId, roleLabel, headcount, level, hoursPerWeek, shift, skills[], otherSkills, notes }]
  setup       Json? // { [questionId]: { picks[], other } } — email system, phone, chat apps, etc.
  notes       String?
  heardFrom   String?
  status      IntakeStatus @default(NEW)
  adminNote   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, createdAt])
}

// Agreement text employees sign in the app (contractor agreement, NDA). Admins edit it at
// /admin/agreements; each save bumps the version. Rows are created on first edit, until then
// the defaults in src/lib/agreements.ts are used.
model AgreementTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String
  body      String
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
}

// One electronic signature. Keeps an exact copy of the text that was signed, plus the
// signed PDF (an EmployeeDocument) with the Talnt logo.
model Signature {
  id             String   @id @default(cuid())
  employeeId     String
  agreementKey   String
  title          String
  version        Int
  body           String
  signerName     String
  signatureImage String // PNG data URL of the drawn signature
  ip             String?
  userAgent      String?
  documentId     String?  @unique
  signedAt       DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}
